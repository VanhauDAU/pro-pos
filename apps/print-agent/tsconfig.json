{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@contracts/*": ["../../src/contracts/*"],
      "@domain/*": ["../../src/domain/*"],
      "@printing/*": ["../../src/printing/*"]
    }
  },
  "include": ["src/**/*"]
}
