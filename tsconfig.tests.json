{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.tests.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node",
      "vitest/globals",
      "@cloudflare/workers-types",
      "@cloudflare/vitest-pool-workers/types"
    ],
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "paths": {
      "@client/*": ["./src/client/*"],
      "@server/*": ["./src/server/*"],
      "@contracts/*": ["./src/contracts/*"],
      "@domain/*": ["./src/domain/*"],
      "@printing/*": ["./src/printing/*"]
    }
  },
  "include": [
    "tests",
    "src/server",
    "src/contracts",
    "src/domain",
    "src/printing",
    "src/client/features/guest/guest-assistant.ts",
    "src/client/features/pos/payment-return-state.ts",
    "src/client/features/pos/payment-navigation.ts",
    "src/client/features/pos/pos-customer-access.ts",
    "src/client/features/pos/pos-error.ts",
    "src/client/features/pos/pos-order-query.ts",
    "src/client/features/pos/pos-notification-tracker.ts",
    "src/client/realtime/client.ts",
    "src/client/features/owner/catalog-excel.ts",
    "src/client/features/owner/print-preview-sample.ts",
    "src/client/lib/pos-receipt-printer.ts",
    "src/client/lib/print-document-identity.ts",
    "src/client/lib/print-bridge-service.ts",
    "apps/print-agent/src",
    "src/client/lib/onboarding-audio.ts",
    "src/client/lib/sound.ts",
    "src/client/lib/api.ts",
    "src/client/lib/request-activity.ts",
    "src/client/lib/zip.ts",
    "src/client/env.d.ts",
    "worker-configuration.d.ts"
  ]
}
