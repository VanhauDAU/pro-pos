{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pro-pos",
  "main": "./src/server/index.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "preview_urls": true,
  "secrets": {
    "required": [
      "AUTH_PEPPER",
      "DEVICE_TOKEN_PEPPER",
      "SESSION_TOKEN_PEPPER",
      "SYSTEM_BOOTSTRAP_SECRET",
      "VAPID_PUBLIC_KEY",
      "VAPID_PRIVATE_KEY",
      "VAPID_SUBJECT",
    ],
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 },
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "STORE_REALTIME",
        "class_name": "StoreRealtimeRoom",
      },
    ],
  },
  "migrations": [
    {
      "tag": "realtime-v1",
      "new_sqlite_classes": ["StoreRealtimeRoom"],
    },
  ],
  "triggers": {
    "crons": ["17 18 * * *"],
  },
  "vars": {
    "ENVIRONMENT": "local",
    "APP_VERSION": "0.1.0",
    "BUILD_SHA": "local-dev",
    "BUILD_TIME": "local",
    "STORE_TIMEZONE": "Asia/Ho_Chi_Minh",
    "COOKIE_MODE": "local",
    "ACCESS_BRIDGE_URL": "http://127.0.0.1:8788",
    "ACCESS_TEAM_DOMAIN": "shy-mountain-5e8a.cloudflareaccess.com",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pro-pos-local-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "pro-pos-local-media",
    },
  ],
  "env": {
    "staging": {
      "name": "pro-pos-staging",
      "durable_objects": {
        "bindings": [
          {
            "name": "STORE_REALTIME",
            "class_name": "StoreRealtimeRoom",
          },
        ],
      },
      "triggers": {
        "crons": ["17 18 * * *"],
      },
      "secrets": {
        "required": [
          "AUTH_PEPPER",
          "DEVICE_TOKEN_PEPPER",
          "SESSION_TOKEN_PEPPER",
          "SYSTEM_BOOTSTRAP_SECRET",
          "VAPID_PUBLIC_KEY",
          "VAPID_PRIVATE_KEY",
          "VAPID_SUBJECT",
        ],
      },
      "vars": {
        "ENVIRONMENT": "staging",
        "APP_VERSION": "0.1.0",
        "BUILD_SHA": "set-by-release-workflow",
        "BUILD_TIME": "set-by-release-workflow",
        "STORE_TIMEZONE": "Asia/Ho_Chi_Minh",
        "COOKIE_MODE": "secure",
        "ACCESS_BRIDGE_URL": "https://pro-pos-auth-staging.vanhau-laravel.workers.dev",
        "ACCESS_TEAM_DOMAIN": "",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "pro-pos-staging-db",
          "database_id": "7ec0c566-2bf4-48b9-a9e6-fd5b75b6dc31",
          "migrations_dir": "./migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "pro-pos-staging-media",
        },
      ],
    },
    "production": {
      "name": "pro-pos-production",
      "durable_objects": {
        "bindings": [
          {
            "name": "STORE_REALTIME",
            "class_name": "StoreRealtimeRoom",
          },
        ],
      },
      "triggers": {
        "crons": ["17 18 * * *"],
      },
      "secrets": {
        "required": [
          "AUTH_PEPPER",
          "DEVICE_TOKEN_PEPPER",
          "SESSION_TOKEN_PEPPER",
          "SYSTEM_BOOTSTRAP_SECRET",
          "VAPID_PUBLIC_KEY",
          "VAPID_PRIVATE_KEY",
          "VAPID_SUBJECT",
        ],
      },
      "vars": {
        "ENVIRONMENT": "production",
        "APP_VERSION": "0.1.0",
        "BUILD_SHA": "set-by-release-workflow",
        "BUILD_TIME": "set-by-release-workflow",
        "STORE_TIMEZONE": "Asia/Ho_Chi_Minh",
        "COOKIE_MODE": "secure",
        "ACCESS_BRIDGE_URL": "https://pro-pos-auth-production.vanhau-laravel.workers.dev",
        "ACCESS_TEAM_DOMAIN": "",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "pro-pos-production-db",
          "database_id": "651d7ec6-a2c8-4fa1-82d5-679b6e90c8ca",
          "migrations_dir": "./migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "pro-pos-production-media",
        },
      ],
    },
  },
}
